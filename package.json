{
  "name": "cmeng",
  "version": "0.1.0",
  "private": true,
  "description": "CMeng controlled construction/project evidence and intelligence platform",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/packages/runtime-api/src/server.js",
    "audit:counts": "npm run build && node scripts/audit-aggregate-counts.cjs",
    "test:unit": "npm run build && node --test --test-concurrency=4 $(find dist/tests -name '*.test.js' ! -name '*-scale.test.js')",
    "test:stress": "npm run build && node --test dist/tests/*-scale.test.js",
    "test": "npm run test:unit",
    "verify": "npm run typecheck && npm run test:unit",
    "test:stress:schedule": "npm run build && node --test dist/tests/schedule-modules-scale.test.js",
    "test:stress:boq": "npm run build && node --test dist/tests/boq-scale.test.js",
    "test:stress:xer": "npm run build && node --test dist/tests/xer-scale.test.js",
    "test:release:latency": "npm run build && node scripts/release-latency.cjs",
    "test:release": "npm run verify && npm run test:release:latency"
  },
  "dependencies": {
    "iconv-lite": "0.6.3",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.1",
    "pdf-parse": "2.4.5",
    "tesseract.js": "7.0.0",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.2",
    "pdf-lib": "1.17.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
